{
  "name": "skyfleet-passenger-tracking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5176",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4176",
    "check:env": "node scripts/check-env.mjs",
    "check:health": "node scripts/health-check.mjs",
    "smoke:test": "npm run check:env && npm run build",
    "release:check": "npm run smoke:test && cd backend && php artisan test && cd .. && npm run check:health",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "deploy:host": "node scripts/deploy-host.mjs"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "vite": "^8.2.1"
  }
}
