function TransferPage({ language }) {
  const tr = language === "tr";
  const [submission, setSubmission] = useState({ status: "idle", message: "" });
  const earliestDate = new Date().toISOString().slice(0, 10);

  async function submit(event) {
    event.preventDefault();
    const form = event.currentTarget;
    const formData = new FormData(form);

    const payload = {
      pickup: formData.get("pickup"),
      dropoff: formData.get("dropoff"),
      pickup_date: formData.get("pickup_date"),
      pickup_time: formData.get("pickup_time"),
      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC",
      flight_number: formData.get("flight_number") || null,
      passengers: Number(formData.get("passengers")),
      luggage_count: Number(formData.get("luggage_count") || 0),
      vehicle_type: formData.get("vehicle_type") || null,
      passenger_name: formData.get("passenger_name"),
      passenger_phone: formData.get("passenger_phone"),
      passenger_email: formData.get("passenger_email"),
      note: formData.get("note") || null,
      locale: language,
      terms_accepted: formData.get("terms_accepted") === "1",
    };

    setSubmission({
      status: "submitting",
      message: tr ? "Transfer talebiniz güvenli şekilde gönderiliyor..." : "Submitting your transfer request securely...",
    });

    try {
      const response = await axios.post("/api/public/transfer-requests", payload);
      const reference = response.data?.data?.request_reference;

      setSubmission({
        status: "success",
        message: tr
          ? `Talebiniz alındı. Talep numaranız: ${reference}`
          : `Your request has been received. Request reference: ${reference}`,
      });
      form.reset();
    } catch (error) {
      const validationErrors = error.response?.data?.errors;
      const firstValidationMessage = validationErrors
        ? Object.values(validationErrors).flat()[0]
        : null;

      setSubmission({
        status: "error",
        message: firstValidationMessage
          || error.response?.data?.message
          || (tr
            ? "Talebiniz gönderilemedi. Bilgileri kontrol edip tekrar deneyin."
            : "Your request could not be submitted. Check the details and try again."),
      });
    }
  }

  return <main className="inner-page section-pad">
    <div className="page-intro"><span className="eyebrow">{tr ? "TRANSFER REZERVASYONU" : "BOOK A TRANSFER"}</span><h1>{tr ? "Yolculuğunuzu planlayın." : "Plan your journey."}</h1><p>{tr ? "Transfer detaylarınızı gönderin. Operasyon ekibimiz müsaitlik ve fiyat bilgisiyle size ulaşsın." : "Send your transfer details and our operations team will contact you with availability and pricing."}</p></div>
    <form className="public-form" onSubmit={submit}>
      <FormSection number="01" title={tr ? "Yolculuk" : "Journey"}>
        <Field label={tr ? "Alış noktası" : "Pickup location"} name="pickup" required />
        <Field label={tr ? "Bırakış noktası" : "Drop-off location"} name="dropoff" required />
        <Field label={tr ? "Tarih" : "Date"} name="pickup_date" type="date" min={earliestDate} required />
        <Field label={tr ? "Saat" : "Time"} name="pickup_time" type="time" required />
        <Field label={tr ? "Uçuş numarası" : "Flight number"} name="flight_number" />
        <Field label={tr ? "Yolcu sayısı" : "Passengers"} name="passengers" type="number" min="1" required />
        <Field label={tr ? "Bagaj sayısı" : "Luggage count"} name="luggage_count" type="number" min="0" defaultValue="0" />
        <Field label={tr ? "Araç tercihi" : "Vehicle preference"} name="vehicle_type" placeholder={tr ? "Sedan, Minivan, Minibüs" : "Sedan, Minivan, Minibus"} />
      </FormSection>
      <FormSection number="02" title={tr ? "İletişim" : "Contact"}>
        <Field label={tr ? "Ad soyad" : "Full name"} name="passenger_name" autoComplete="name" required />
        <Field label={tr ? "Telefon / WhatsApp" : "Phone / WhatsApp"} name="passenger_phone" type="tel" autoComplete="tel" required />
        <Field label={tr ? "E-posta" : "Email"} name="passenger_email" type="email" autoComplete="email" required />
        <label className="field wide"><span>{tr ? "Not" : "Note"}</span><textarea name="note" rows="4" /></label>
      </FormSection>
      <label className="consent"><input type="checkbox" name="terms_accepted" value="1" required /><span>{tr ? "Bilgilerin doğru olduğunu ve operasyon ekibinin talep hakkında benimle iletişime geçebileceğini kabul ediyorum." : "I confirm the details are accurate and the operations team may contact me about this request."}</span></label>
      <div className="form-submit">
        <button className="button primary" type="submit" disabled={submission.status === "submitting"}>
          {submission.status === "submitting"
            ? (tr ? "Gönderiliyor..." : "Submitting...")
            : (tr ? "Transfer Talebi Gönder" : "Send Transfer Request")}
          <span>→</span>
        </button>
        {submission.status !== "idle" && (
          <p className={`form-notice ${submission.status}`} role="status">
            {submission.message}
          </p>
        )}
      </div>
    </form>
  </main>;
}

function SupplierJoinPage({ language }) {
  const tr = language === "tr";
  const [submission, setSubmission] = useState({ status: "idle", message: "" });

  async function submit(event) {
    event.preventDefault();
    const form = event.currentTarget;
    const formData = new FormData(form);

    formData.set(
      "timezone",
      Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC",
    );

    setSubmission({
      status: "submitting",
      message: tr ? "Başvurunuz güvenli şekilde gönderiliyor..." : "Submitting your application securely...",
    });

    try {
      const response = await axios.post(
        "/api/public/supplier-applications",
        formData,
      );

      const applicationId = response.data?.data?.application_id;

      setSubmission({
        status: "success",
        message: tr
          ? `Başvurunuz alındı. Başvuru numaranız: ${applicationId}`
          : `Your application has been received. Application ID: ${applicationId}`,
      });

      form.reset();
    } catch (error) {
      const validationErrors = error.response?.data?.errors;
      const firstValidationMessage = validationErrors
        ? Object.values(validationErrors).flat()[0]
        : null;

      setSubmission({
        status: "error",
        message: firstValidationMessage
          || error.response?.data?.message
          || (tr
            ? "Başvuru gönderilemedi. Bilgilerinizi kontrol edip tekrar deneyin."
            : "The application could not be submitted. Check your information and try again."),
      });
    }
  }
  return <main className="inner-page supplier-join section-pad">
    <div className="page-intro"><span className="eyebrow">SUPPLIER NETWORK</span><h1>{tr ? "Bizimle kazanmaya başlayın." : "Start earning with us."}</h1><p>{tr ? "Şirketinizi kaydedin, hizmet bölgelerinizi tanımlayın ve belgelerinizi yükleyin. Ekibimiz başvurunuzu inceleyerek sizinle iletişime geçsin." : "Register your company, define your service regions and upload your documents. Our team will review your application and contact you."}</p></div>
    <div className="join-layout">
      <aside><h3>{tr ? "Başvuru süreci" : "Application process"}</h3>{[tr ? "Şirket bilgileri" : "Company details",tr ? "Hizmet bölgeleri" : "Service regions",tr ? "Portal hesabı" : "Portal account",tr ? "Belgeler" : "Documents",tr ? "İnceleme ve onay" : "Review and approval"].map((x,i)=><div key={x}><span>{i+1}</span><p>{x}</p></div>)}<small>{tr ? "Onaylanmadan hiçbir hesap operasyona erişemez." : "No account can access operations before approval."}</small></aside>
      <form className="public-form compact" onSubmit={submit}>
        <FormSection number="01" title={tr ? "Şirket bilgileri" : "Company details"}>
          <Field label={tr ? "Ticari unvan" : "Company name"} name="company_name" required />
          <Field label={tr ? "Yetkili kişi" : "Contact person"} name="contact_name" required />
          <Field label={tr ? "Şirket e-postası" : "Company email"} name="company_email" type="email" autoComplete="email" required />
          <Field label={tr ? "Telefon / WhatsApp" : "Phone / WhatsApp"} name="company_phone" autoComplete="tel" required />
          <Field label={tr ? "Ülke" : "Country"} name="country_name" required />
          <Field label={tr ? "Ülke kodu (TR, ES, EG)" : "Country code (TR, ES, EG)"} name="country_code" minLength="2" maxLength="2" required />
          <Field label={tr ? "Şehir" : "City"} name="city" required />
          <Field label={tr ? "Vergi numarası" : "Tax number"} name="tax_number" />
          <Field label={tr ? "Şirket kayıt numarası" : "Registration number"} name="registration_number" />
        </FormSection>
        <FormSection number="02" title={tr ? "Operasyon kapasitesi" : "Operational capacity"}>
          <Field label={tr ? "Hizmet verilen bölgeler" : "Service regions"} name="service_regions" required />
          <Field label={tr ? "Araç sayısı" : "Fleet size"} name="fleet_size" type="number" min="1" required />
          <Field label={tr ? "Araç türleri" : "Vehicle types"} name="vehicle_types" placeholder="Sedan, Minivan, Minibus" required />
          <Field label={tr ? "Web sitesi" : "Website"} name="website" type="url" />
          <Field label={tr ? "Hakediş para birimi" : "Payout currency"} name="default_currency" defaultValue="EUR" minLength="3" maxLength="3" required />
        </FormSection>
        <FormSection number="03" title={tr ? "Portal hesabı" : "Portal account"}>
          <Field label={tr ? "Şifre" : "Password"} name="portal_password" type="password" autoComplete="new-password" minLength="8" required />
          <Field label={tr ? "Şifre tekrarı" : "Confirm password"} name="portal_password_confirmation" type="password" autoComplete="new-password" minLength="8" required />
        </FormSection>
        <FormSection number="04" title={tr ? "Belgeler" : "Documents"}>
          <FileField label={tr ? "Şirket kayıt belgesi" : "Company registration"} name="company_registration_file" required />
          <FileField label={tr ? "Vergi belgesi" : "Tax document"} name="tax_document_file" required />
          <FileField label={tr ? "Sigorta belgesi" : "Insurance certificate"} name="insurance_file" required />
          <FileField label={tr ? "Taşıma/turizm lisansı (varsa)" : "Transport/tourism licence (if applicable)"} name="transport_license_file" />
        </FormSection>
        <label className="consent"><input type="checkbox" name="terms_accepted" value="1" required /><span>{tr ? "Bilgilerin doğru olduğunu ve başvurunun operasyon ekibi tarafından inceleneceğini kabul ediyorum." : "I confirm that the information is accurate and may be reviewed by the operations team."}</span></label>
        <div className="form-submit">
          <button className="button primary" type="submit" disabled={submission.status === "submitting"}>
            {submission.status === "submitting"
              ? (tr ? "Gönderiliyor..." : "Submitting...")
              : (tr ? "Başvuruyu Gönder" : "Submit Application")}
            <span>→</span>
          </button>
          {submission.status !== "idle" && (
            <p className={`form-notice ${submission.status}`} role="status">
              {submission.message}
            </p>
          )}
        </div>
      </form>
    </div>
  </main>;
}

function FormSection({ number, title, children }) { return <fieldset><legend><span>{number}</span>{title}</legend><div className="form-grid">{children}</div></fieldset>; }
function Field({ label, ...props }) { return <label className="field"><span>{label}</span><input {...props} /></label>; }
function FileField({ label, ...props }) { return <label className="field file-field"><span>{label}</span><input type="file" accept=".pdf,.jpg,.jpeg,.png,.webp" {...props} /></label>; }

function Footer({ language }) {
  const tr = language === "tr";
  return <footer className="site-footer section-pad"><a className="brand footer-brand" href="/"><span className="brand-mark"><i />ST</span><span><strong>SKYTRIP</strong><em>TRANSFER</em><small>Global Mobility Network</small></span></a><p>{tr ? "Global havalimanı transfer operasyonları ve tedarikçi ağı." : "Global airport transfer operations and supplier network."}</p><div><a href="/transfer">{tr ? "Transfer" : "Book a transfer"}</a><a href="/supplier/join">{tr ? "Tedarikçi ol" : "Become a supplier"}</a><a href="/supplier/">{tr ? "Giriş" : "Login"}</a></div><small>© 2026 SkyTripTransfer. All rights reserved.</small></footer>;
}

function getPage(pathname) {
  const normalized = pathname.replace(/\/+$/, "") || "/";
  if (normalized === "/transfer") return "transfer";
  if (normalized === "/supplier/join") return "supplier";
  return "home";
}
